# Application
NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/sreoncall?replicaSet=rs0

# Redis
REDIS_URL=redis://localhost:6379

# NATS
NATS_URL=nats://localhost:4222

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=masterKey

# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Platform Admin (seeded on first boot — REQUIRED, no in-code default)
# Generate a strong unique password; first login will force a change anyway.
PLATFORM_ADMIN_EMAIL=admin@sreoncall.dev
PLATFORM_ADMIN_PASSWORD=

# AWS (Route53, SES) — IAM user: sreoncallv2, Account: 234438862968
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMTP (AWS SES)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Vault (optional)
VAULT_ADDR=
VAULT_TOKEN=

# Internal API
INTERNAL_API_URL=http://localhost:4000

# Public-facing app URL (used for OAuth redirects, email links, etc.)
APP_URL=http://localhost:3000

# Encryption key for sensitive tokens stored in MongoDB:
#   - Slack / Teams bot tokens (comms integrations)
#   - Tenant AI API keys (BYOK — Settings → AI)
#   - MFA TOTP secrets
# Must be 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
# WARNING: changing this value invalidates all previously encrypted tokens.
COMMS_ENCRYPTION_KEY=

# Slack Integration (OAuth for consumer tenant communication channels)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# OpenAI — used for AI summary PDF generation in reports
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# AI Notetaker — capture + transcribe + summarize war-room calls.
# Recall.ai meeting bot (Zoom/Meet/Teams/Slack Huddles). Leave RECALL_API_KEY
# blank to disable the meeting-bot path; offline file uploads still work.
RECALL_API_KEY=
RECALL_API_REGION=us-east-1
RECALL_WEBHOOK_SECRET=
# Pluggable speech-to-text: whisper (uses OPENAI_API_KEY), deepgram, or recall
# (use Recall.ai's own transcript). Default: whisper.
STT_PROVIDER=whisper
DEEPGRAM_API_KEY=
# Public base URL Recall.ai calls back for bot status / transcript webhooks
# (e.g. https://app.sreoncall.com). Required for the meeting-bot path.
NOTETAKER_PUBLIC_BASE_URL=

# Calendar auto-capture (Recall Calendar V2). Google/Microsoft OAuth app
# credentials — we run the OAuth and hand the refresh token to Recall.
# Redirect URIs to register:
#   {APP_URL}/api/v1/oauth/calendar/google/callback
#   {APP_URL}/api/v1/oauth/calendar/microsoft/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common
